# Banco de dados (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database"

# Porta do servidor Express (Railway injeta PORT automaticamente)
PORT=4000

# Autenticação do painel administrativo
JWT_SECRET="gerar-com: openssl rand -base64 32"
JWT_EXPIRES_IN="7d"

# Origem permitida para CORS — domínio do front na Vercel
WEB_ORIGIN="https://reflorescerartesanal.com.br"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (e-mail transacional e newsletter)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="contato@reflorescerartesanal.com.br"

# Gateway de pagamento ativo (mercadopago | pagarme)
PAYMENT_PROVIDER="mercadopago"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
